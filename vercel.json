{
  "version": 2,
  "builds": [
    {
      "src": "api/index.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    { "src": "/api/(.*)", "dest": "/api/index.js" },
    { "handle": "filesystem" },
    { "src": "/(.*\\.html)", "dest": "/client/$1" },
    { "src": "/logo.png", "dest": "/client/logo.png" },
    { "src": "/upi-qr.jpeg", "dest": "/client/upi-qr.jpeg" },
    { "src": "/favicon.ico", "dest": "/client/favicon.ico" },
    { "src": "/", "dest": "/index.html" }
  ]
}